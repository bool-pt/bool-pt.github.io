---
import { Image } from 'astro:assets';
import { CookiePreferencesButton, CONSENT_ENABLED } from '@bool/compliance';
import Icon from '../../primitives/Icon/Icon.astro';
import ObfuscatedLink from '../../primitives/ObfuscatedLink/ObfuscatedLink.astro';

interface FooterLabels {
  tagline: string;
  taglineHref: string;
  socialAria: string;
  socialLabels: Record<string, string>;
  socialUrls: Record<string, string>;
  quickLinksHeading: string;
  legalLinksHeading: string;
  findUsHeading: string;
  address: string;
  copyright: string;
  signatureImage: ImageMetadata;
  signatureAlt: string;
  companyName: string;
  companyEmail: string;
  companyPhone: string;
  quickLinks: { label: string; href: string }[];
  legalLinks: { label: string; href: string }[];
  cookiePreferencesLabel: string;
}

interface Props {
  labels: FooterLabels;
}

const { labels } = Astro.props;

const socialLinks = [
  { key: 'facebook', href: labels.socialUrls.facebook },
  { key: 'instagram', href: labels.socialUrls.instagram },
  { key: 'linkedin', href: labels.socialUrls.linkedin },
  { key: 'twitter', href: labels.socialUrls.twitter, size: 26 },
  { key: 'youtube', href: labels.socialUrls.youtube },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Brand + tagline + social -->
    <div class="footer-brand">
      <p class="footer-tagline">
        <a
          href={labels.taglineHref}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-tagline-link"
        >
          {labels.tagline}
        </a>
      </p>
      <div class="footer-social" aria-label={labels.socialAria}>
        {
          socialLinks.map(({ key, href, size }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={labels.socialLabels[key] ?? key}
              class="social-icon"
            >
              <Icon name={key} size={size ?? 20} />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Quick Links -->
    <div class="footer-col">
      <h3 class="footer-heading">{labels.quickLinksHeading}</h3>
      <ul role="list" class="footer-link-list">
        {
          labels.quickLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="footer-link">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Legal Links -->
    <div class="footer-col">
      <h3 class="footer-heading">{labels.legalLinksHeading}</h3>
      <ul role="list" class="footer-link-list">
        {
          labels.legalLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="footer-link">
                {label}
              </a>
            </li>
          ))
        }
        {
          CONSENT_ENABLED && (
            <li>
              <CookiePreferencesButton label={labels.cookiePreferencesLabel} client:load />
            </li>
          )
        }
      </ul>
    </div>

    <!-- Contact info -->
    <div class="footer-col">
      <h3 class="footer-heading">{labels.findUsHeading}</h3>
      <address class="footer-address">
        <p>{labels.address}</p>
        <ObfuscatedLink
          href={`mailto:${labels.companyEmail}`}
          label={labels.companyEmail}
          class="footer-link"
        />
        {
          labels.companyPhone && (
            <ObfuscatedLink
              href={`tel:${labels.companyPhone.replace(/\s/g, '')}`}
              label={labels.companyPhone}
              class="footer-link"
            />
          )
        }
      </address>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="copyright-line">
        <span class="copyright-icon">&copy;</span>{labels.copyright}
        {new Date().getFullYear()}
        {labels.companyName}
      </p>
      <Image
        src={labels.signatureImage}
        alt={labels.signatureAlt}
        width={384}
        height={32}
        class="footer-signature"
        loading="lazy"
      />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark-muted);
    margin-block-start: -1px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-inline-size: 1920px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3rem 1.5rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      padding-inline: 4rem;
    }
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 2rem;
      align-items: start;
    }
  }

  .footer-tagline {
    font-size: 1.125rem;
    line-height: 1.22;
    color: var(--color-on-dark);
    margin: 0 0 1.5rem;
    max-inline-size: 24rem;
  }

  .footer-tagline-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms;
  }

  .footer-tagline-link:hover {
    text-decoration: underline;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-block-start: 2.5rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-full);
    background-color: var(--color-background);
    color: var(--color-foreground);
    text-decoration: none;
    transition:
      background-color 150ms,
      color 150ms;
  }

  .social-icon:hover {
    background-color: var(--white-80);
    color: var(--color-foreground);
  }

  .footer-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-on-dark);
    margin: 0 0 1.25rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.875rem;
    line-height: 1.43;
    color: var(--color-on-dark);
    text-decoration: none;
    transition: color 150ms;
    display: inline-block;
  }

  .footer-link:hover {
    color: var(--color-on-dark);
  }

  .footer-address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-address p {
    font-size: 1rem;
    color: var(--color-on-dark);
    margin: 0;
    line-height: 1.22;
  }

  .footer-bottom {
    border-block-start: none;
    padding-inline: 1.5rem;
    padding-block: 0.875rem 3rem;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      padding-inline: 4rem;
    }
  }

  .footer-bottom-inner {
    max-inline-size: 1920px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .footer-bottom p {
    margin-block: 0;
    font-size: 1.125rem;
    line-height: 1.22;
    color: var(--color-on-dark);
  }

  .copyright-line {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .copyright-icon {
    color: var(--white-40);
  }

  .footer-signature {
    inline-size: 384px;
    max-inline-size: 100%;
    block-size: auto;
    flex-shrink: 0;
  }
</style>
