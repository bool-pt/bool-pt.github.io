---
import { Image } from 'astro:assets';
import logo from '@bool/media/images/logos/brand/bool-logo-mark.png';
import { NAV_LINKS, ROUTES } from '@bool/shared';
import MobileNav from '../MobileNav/MobileNav';

interface MobileNavLabels {
  open: string;
  title: string;
  navAria: string;
  linkLabels: Record<string, string>;
}

interface LocaleOption {
  code: string;
  flag: string;
  name: string;
}

interface LanguageSelectLabels {
  ariaLabel: string;
  currentLocale: string;
  defaultLocale: string;
  locales: LocaleOption[];
}

interface Props {
  navAria: string;
  logoAria: string;
  ctaLabel: string;
  linkLabels: Record<string, string>;
  mobileNavLabels: MobileNavLabels;
  languageSelectLabels: LanguageSelectLabels;
}

const { navAria, logoAria, ctaLabel, linkLabels, mobileNavLabels, _languageSelectLabels } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav aria-label={navAria}>
    <a href={ROUTES.home} class="site-logo" aria-label={logoAria}>
      <Image src={logo} alt="" width={50} height={50} />
    </a>

    <ul class="nav-links" role="list">
      {
        NAV_LINKS.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={currentPath === href ? 'page' : undefined}
              class:list={['nav-link', { 'nav-link--active': currentPath === href }]}
            >
              {linkLabels[label] ?? label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="header-actions">
      <a href={ROUTES.contacts} class="header-cta">{ctaLabel}</a>
      <!-- LanguageSelect hidden until multi-locale rollout
      <LanguageSelect
        client:load
        currentLocale={languageSelectLabels.currentLocale}
        defaultLocale={languageSelectLabels.defaultLocale}
        locales={languageSelectLabels.locales}
        ariaLabel={languageSelectLabels.ariaLabel}
      /> -->
      <MobileNav client:load links={NAV_LINKS} logoSrc={logo.src} homeHref={ROUTES.home} labels={mobileNavLabels} />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    inline-size: 100%;
    max-inline-size: 1440px;
    z-index: 40;
    background-color: var(--black-65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--shadow-subtle);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-inline-size: 1440px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    block-size: 5.625rem;
  }

  @media (min-width: 640px) {
    nav {
      padding-inline: 4rem;
    }
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-links {
    display: none;
    list-style: none;
    margin: 0;
    margin-inline-start: 2rem;
    padding: 0;
    gap: 0;
    flex: 1;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
      align-items: center;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding-inline: 1rem;
    padding-block: 0.5rem;
    font-size: var(--font-size-body);
    font-weight: 400;
    text-decoration: none;
    color: var(--color-on-dark);
    transition: opacity 150ms;
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-link--active {
    color: var(--color-on-dark);
    font-weight: 700;
    opacity: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }

  .header-cta {
    display: none;
    padding-inline: 1.5rem;
    padding-block: 0.75rem;
    background-color: var(--color-primary);
    color: var(--color-on-dark);
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    text-decoration: none;
    border-radius: 28px;
    white-space: nowrap;
    transition: background-color 150ms;
  }

  .header-cta:hover {
    background-color: var(--color-primary-hover);
  }

  @media (min-width: 768px) {
    .header-cta {
      display: inline-flex;
      align-items: center;
    }
  }

  .header-actions > :global(astro-island:last-child) {
    display: block;
  }

  @media (min-width: 768px) {
    .header-actions > :global(astro-island:last-child) {
      display: none;
    }
  }

  .header-actions :global(button) {
    color: var(--color-on-dark);
  }
</style>
