---
import ArrowLink from '../../compositions/ArrowLink/ArrowLink.astro';
import ListRow from '../../compositions/ListRow/ListRow.astro';
import SectionIntro from '../../compositions/SectionIntro/SectionIntro.astro';
import SectionTag from '../../compositions/SectionTag/SectionTag.astro';
import DashedCard from '../../primitives/DashedCard/DashedCard.astro';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';
import TextBlock from '../../primitives/TextBlock/TextBlock.astro';

interface Props {
  tag: string;
  heading: string;
  body: string;
  viewMoreLabel: string;
  pressReleases: Array<{ date: string; title: string; description: string; href: string }>;
}

const { tag, heading, body, viewMoreLabel, pressReleases } = Astro.props;
---

<Section background="var(--color-surface-warm-dark)" aria-labelledby="press-heading">
  <SectionContainer>
    <SectionIntro
      headingId="press-heading"
      align="start"
      colorScheme="dark"
      descriptionMaxWidth="36rem"
    >
      <SectionTag slot="tag">{tag}</SectionTag>
      <Fragment slot="heading">{heading}</Fragment>
      <Fragment slot="description">{body}</Fragment>
    </SectionIntro>

    <div class="press-list" role="list">
      {
        pressReleases.map((item) => (
          <div class="press-card">
            <DashedCard colorScheme="dark">
              <ListRow colorScheme="dark" role="listitem" class="press-row">
                <span slot="leading" class="press-date">
                  {item.date}
                </span>
                <Fragment slot="content">
                  <TextBlock
                    headingLevel="h3"
                    headingSize="1.5rem"
                    colorScheme="dark"
                    bodySize="1.125rem"
                    bodyMaxWidth="40rem"
                    spacing="0.5rem"
                  >
                    <Fragment slot="heading">{item.title}</Fragment>
                    <p>{item.description}</p>
                  </TextBlock>
                </Fragment>
                <ArrowLink
                  slot="trailing"
                  href={item.href}
                  label={viewMoreLabel}
                  colorScheme="dark"
                />
              </ListRow>
            </DashedCard>
          </div>
        ))
      }
    </div>
  </SectionContainer>
</Section>

<style>
  .press-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .press-card :global(.list-row) {
    border-block-start: none;
    padding: 1.5rem 1.25rem;
    align-items: center !important;
  }

  @media (min-width: 768px) {
    .press-card :global(.list-row) {
      padding: 1.5rem 1rem;
    }
  }

  .press-card :global(.list-row:last-child) {
    border-block-end: none;
  }

  .press-card :global(.list-row-leading),
  .press-card :global(.list-row-trailing) {
    align-items: center !important;
    padding-block-start: 0 !important;
  }

  .press-date {
    font-size: clamp(1rem, 3vw, 1.5rem);
    font-weight: 500;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .press-card :global(.arrow-link) {
    color: var(--color-on-dark) !important;
    font-size: 1.125rem;
  }
</style>
