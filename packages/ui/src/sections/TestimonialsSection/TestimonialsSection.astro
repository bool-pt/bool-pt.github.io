---
import avatarFallback from '@bool/media/images/portraits/portrait.png';
import SectionIntro from '../../compositions/SectionIntro/SectionIntro.astro';
import TestimonialsCarousel from '../../compositions/TestimonialsCarousel/TestimonialsCarousel';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';

interface TestimonialItem {
  quote: string;
  company: string;
  designation: string;
  /** Optional per-testimonial avatar (path to image). Falls back to defaultAvatar then portrait placeholder. */
  avatar?: string;
}

interface Props {
  heading: string;
  description: string;
  testimonials?: TestimonialItem[];
  /** Default avatar shown when an item has no `avatar` of its own. */
  defaultAvatar?: ImageMetadata;
  backgroundImage?: ImageMetadata;
}

const {
  heading,
  description,
  testimonials = [],
  defaultAvatar = avatarFallback,
  backgroundImage,
} = Astro.props;
const fallbackSrc = defaultAvatar.src;
const enrichedTestimonials = testimonials.map((t) => ({ ...t, avatar: t.avatar ?? fallbackSrc }));
---

<Section
  aria-labelledby="testimonials-heading"
  background="var(--black-16)"
  paddingBlock="5rem 3rem"
  style="min-block-size: 652px"
  backgroundImage={backgroundImage?.src}
>
  <SectionContainer>
    <div class="testimonials-section">
      <SectionIntro
        headingId="testimonials-heading"
        colorScheme="light"
        descriptionMaxWidth="63rem"
        bodyLineHeight="1.35"
      >
        <Fragment slot="heading">{heading}</Fragment>
        <Fragment slot="description">{description}</Fragment>
      </SectionIntro>
      <div class="testimonials-carousel-wrap">
        <TestimonialsCarousel
          testimonials={enrichedTestimonials}
          variant="light"
          avatarSrc={fallbackSrc}
          client:visible
        />
      </div>
    </div>
  </SectionContainer>
</Section>

<style>
  .testimonials-section :global(.section-intro-heading) {
    margin-block-end: 1.75rem;
  }

  .testimonials-section :global(.section-intro) {
    margin-block-end: 1rem;
  }

  .testimonials-carousel-wrap {
    padding-inline: 0;
  }
</style>
