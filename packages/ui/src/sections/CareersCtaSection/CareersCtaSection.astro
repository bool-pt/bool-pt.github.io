---
import ctaBg from '@bool/media/images/sections/cta-background.jpg';
import { ROUTES } from '@bool/shared';
import BoolLettersOverlay from '../../compositions/BoolLettersOverlay/BoolLettersOverlay.astro';
import CTASection from '../../compositions/CTASection/CTASection.astro';
import SectionTag from '../../compositions/SectionTag/SectionTag.astro';
import ButtonLink from '../../primitives/ButtonLink/ButtonLink.astro';

interface Props {
  tag: string;
  heading: string;
  body: string;
  cta: string;
}

const { tag, heading, body, cta } = Astro.props;
---

<CTASection
  headingId="careers-cta-heading"
  align="start"
  minHeight="446px"
  contentMaxWidth="42rem"
  class="careers-cta"
  style={`--cta-bg-image: url(${ctaBg.src})`}
>
  <SectionTag slot="tag" tagColor="primary">{tag}</SectionTag>
  <Fragment slot="heading">{heading}</Fragment>
  <Fragment slot="body">{body}</Fragment>
  <ButtonLink href={ROUTES.contacts} variant="primary">{cta}</ButtonLink>
  <div class="careers-letters">
    <BoolLettersOverlay opacity={0.15} variant="compact" />
  </div>
</CTASection>

<style>
  :global(.careers-cta) {
    position: relative;
    background-image: none !important;
    overflow: hidden;
  }

  :global(.careers-cta::before) {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--cta-bg-image);
    background-size: cover;
    background-position: center;
    filter: grayscale(1) brightness(0.35) blur(1px);
    z-index: 0;
  }

  :global(.careers-cta::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--black-60) 0%, transparent 60%);
    z-index: 0;
  }

  :global(.careers-cta > *) {
    position: relative;
    z-index: 2;
  }

  :global(.careers-cta .careers-letters) {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    color: var(--color-on-dark);
    overflow: hidden;
    filter: blur(1.5px);
  }

  :global(.careers-cta .text-block-heading) {
    font-size: 48px !important;
    font-weight: 700 !important;
    line-height: 42px !important;
    letter-spacing: 0 !important;
  }

  :global(.careers-cta .text-block--dark .text-block-body) {
    max-inline-size: 42rem !important;
  }

  :global(.careers-cta .text-block--dark .text-block-body p) {
    color: var(--color-on-dark) !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
  }
</style>
