---
import ctaBgFallback from '@bool/media/images/backgrounds/cta-background.jpg';
import { ROUTES } from '@bool/shared';
import CTASection from '../../compositions/CTASection/CTASection.astro';
import ButtonLink from '../../primitives/ButtonLink/ButtonLink.astro';

interface Props {
  heading: string;
  body: string;
  button: string;
  backgroundImage?: ImageMetadata;
}

const { heading, body, button, backgroundImage = ctaBgFallback } = Astro.props;
---

<CTASection
  headingId="lets-build-heading"
  align="center"
  minHeight="355px"
  contentMaxWidth="50rem"
  class="lets-build"
  style={`--cta-bg-image: url(${backgroundImage.src})`}
>
  <Fragment slot="heading">{heading}</Fragment>
  <Fragment slot="body">{body}</Fragment>
  <ButtonLink href={ROUTES.contacts} variant="primary">{button}</ButtonLink>
</CTASection>

<style>
  :global(.lets-build) {
    position: relative;
    background-image: none !important;
  }

  :global(.lets-build::before) {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--cta-bg-image);
    background-size: cover;
    background-position: center;
    filter: grayscale(1) brightness(0.4) blur(1.5px);
    z-index: 0;
  }

  :global(.lets-build > *) {
    position: relative;
    z-index: 1;
  }

  :global(.lets-build .text-block-heading) {
    font-size: 48px !important;
  }

  :global(.lets-build .text-block--dark .text-block-body p) {
    color: var(--color-on-dark) !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    line-height: 1.2 !important;
  }
</style>
