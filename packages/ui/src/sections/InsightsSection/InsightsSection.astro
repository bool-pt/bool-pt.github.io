---
import blogImg1Fallback from '@bool/media/images/covers/insight-01.jpg';
import blogImg2Fallback from '@bool/media/images/covers/insight-02.jpg';
import blogImg3Fallback from '@bool/media/images/covers/insight-03.jpg';
import { ROUTES } from '@bool/shared';
import ArrowLink from '../../compositions/ArrowLink/ArrowLink.astro';
import ImageOverlayCard from '../../compositions/ImageOverlayCard/ImageOverlayCard.astro';
import IntroGridSection from '../../compositions/IntroGridSection/IntroGridSection.astro';
import AuthorMeta from '../../primitives/AuthorMeta/AuthorMeta.astro';
import CardImageBg from '../../primitives/CardImageBg/CardImageBg.astro';
import CardTitle from '../../primitives/CardTitle/CardTitle.astro';

const fallbackImages = [blogImg1Fallback, blogImg2Fallback, blogImg3Fallback];

interface PostItem {
  slug: string;
  title: string;
  author: string;
  date: string;
  image?: string;
}

interface Props {
  heading: string;
  description: string;
  posts?: PostItem[];
  readMoreLabel?: string;
}

const { heading, description, posts = [], readMoreLabel = 'Read more' } = Astro.props;
---

<div class="insights-wrap">
  <IntroGridSection
    headingId="insights-heading"
    headingSize="var(--font-size-display)"
    background="var(--color-background)"
    gridColumns={3}
    gridCollapseAt="md"
    paddingBlock="4rem"
  >
    <Fragment slot="heading">{heading}</Fragment>
    <Fragment slot="description">{description}</Fragment>

    {
      posts.map((post, i) => (
        <ImageOverlayCard
          aspectRatio="384/470"
          gradient="linear-gradient(to top, var(--black-75) 0%, var(--black-20) 50%, transparent 70%)"
          hoverEffect="lift"
        >
          <CardImageBg
            slot="image"
            src={post.image ?? (fallbackImages[i % fallbackImages.length] as ImageMetadata).src}
          />
          <AuthorMeta
            author={post.author}
            date={post.date}
            colorScheme="dark"
            class="insight-card-meta"
          />
          <CardTitle colorScheme="dark" class="insight-card-title">
            {post.title}
          </CardTitle>
          <ArrowLink
            href={`${ROUTES.blog}/${post.slug}`}
            label={readMoreLabel}
            colorScheme="dark"
          />
        </ImageOverlayCard>
      ))
    }
  </IntroGridSection>
</div>

<style>
  .insights-wrap :global(.insight-card-meta) {
    margin-block-end: 1rem;
  }

  .insights-wrap :global(.insight-card-title) {
    margin-block-end: 2rem;
  }

  .insights-wrap :global(.section-intro) {
    margin-block-end: 4rem;
  }

  .insights-wrap :global(.arrow-link--dark) {
    color: var(--color-on-dark) !important;
  }
</style>
