---
import { COMPANY, ROUTES } from '@bool/shared';
import { t } from '@bool/i18n';
import ExpertPortrait from '../../compositions/ExpertPortrait/ExpertPortrait.astro';
import ActionRow from '../../primitives/ActionRow/ActionRow.astro';
import ButtonLink from '../../primitives/ButtonLink/ButtonLink.astro';
import CheckListItem from '../../primitives/CheckListItem/CheckListItem.astro';
import Icon from '../../primitives/Icon/Icon.astro';
import TextBlock from '../../primitives/TextBlock/TextBlock.astro';

interface Props {
  expert: string;
  role: string;
  name: string;
  body: string;
  features: string[];
  availableConsultation: string;
  contactExpert: string;
  contactExpertHref?: string;
  email?: string;
  linkedin?: string;
  image: ImageMetadata;
  reversed?: boolean;
  /** Per-card anchor id, so links can target this specific card. */
  id?: string;
}

const {
  expert,
  role,
  name,
  body,
  features,
  availableConsultation,
  contactExpert,
  contactExpertHref = ROUTES.contacts,
  email = COMPANY.email,
  linkedin = t('footer.social.linkedin.href'),
  image,
  reversed = false,
  id,
} = Astro.props;
---

<article id={id} class:list={['techCard', { 'techCard--reversed': reversed }]}>
  <div class="techCardPersonWrap">
    <ExpertPortrait
      name={expert}
      role={role}
      photo={image}
      email={email}
      linkedin={linkedin}
      colorScheme="light"
      class="techCardExpert"
    />
  </div>
  <div class="techCardContent">
    <TextBlock
      headingLevel="h3"
      headingId={undefined}
      headingSize="clamp(1.75rem, 4vw, 2.5rem)"
      bodySize="clamp(1rem, 2.5vw, 1.25rem)"
      bodyLineHeight="1.27"
      colorScheme="light"
      bodyMaxWidth="100%"
      spacing="1.5rem"
    >
      <Fragment slot="heading">{name}</Fragment>
      <p>{body}</p>
    </TextBlock>
    <ul
      class="techCardFeatures"
      role="list"
      style="--color-success: var(--color-surface-warm-dark); --check-border: 2.5px solid var(--black-10);"
    >
      {features.map((feature) => <CheckListItem class="techCardFeature">{feature}</CheckListItem>)}
    </ul>
    <ActionRow gap="2.5rem" class="techCardActions">
      <span class="techCardConsultation">
        <Icon name="calendar" size={20} />
        <span>{availableConsultation}</span>
      </span>
      <ButtonLink href={contactExpertHref} variant="primary">{contactExpert}</ButtonLink>
    </ActionRow>
  </div>
</article>

<style>
  .techCard {
    background-color: var(--color-background);
    border: 2px dashed var(--warm-dark-50);
    border-radius: 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    max-inline-size: 100%;
    margin-inline: auto;
    overflow: hidden;
    scroll-margin-block-start: 7rem;
  }

  @media (min-width: 768px) {
    .techCard {
      grid-template-columns: 2fr 3fr;
      min-block-size: 488px;
    }

    .techCard--reversed {
      grid-template-columns: 3fr 2fr;
    }

    .techCard--reversed .techCardPersonWrap {
      order: 2;
      border-radius: 0 0 0 0;
    }

    .techCard--reversed .techCardContent {
      order: 1;
    }
  }

  .techCardPersonWrap {
    background-color: var(--warm-dark-10);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .techCardPersonWrap :global(.ep-photo-wrap) {
    inline-size: clamp(12rem, 50vw, 19.875rem);
    block-size: clamp(12rem, 50vw, 19.875rem);
  }

  @media (min-width: 768px) {
    .techCardPersonWrap {
      padding: 2.5rem;
    }
  }

  @media (min-width: 768px) {
    .techCardPersonWrap {
      border-start-start-radius: 1.375rem;
      border-end-start-radius: 1.375rem;
      border-start-end-radius: 0;
      border-end-end-radius: 0;
    }

    .techCard--reversed .techCardPersonWrap {
      border-start-start-radius: 0;
      border-end-start-radius: 0;
      border-start-end-radius: 1.375rem;
      border-end-end-radius: 1.375rem;
    }
  }

  .techCardExpert {
    justify-content: center;
  }

  .techCardContent {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .techCardContent {
      padding: 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .techCardContent {
      padding: 3rem 2rem 3rem 3rem;
    }
  }

  .techCardContent :global(.text-block-heading) {
    max-inline-size: 30rem;
  }

  .techCardContent :global(.text-block-body p) {
    font-weight: 500;
    color: var(--color-foreground) !important;
  }

  .techCardFeatures {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .techCardFeatures {
      margin: 2.5rem 0 2rem;
    }
  }

  .techCardFeature {
    font-size: var(--font-size-body-lg);
    color: var(--color-foreground);
    line-height: 1.4;
    align-items: center;
  }

  .techCardActions {
    align-items: center;
  }

  .techCardConsultation {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-foreground);
  }
</style>
