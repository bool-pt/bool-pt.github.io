---
import NewsletterForm from '../../compositions/NewsletterForm/NewsletterForm';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';
import TextBlock from '../../primitives/TextBlock/TextBlock.astro';

interface NewsletterLabels {
  subscribed: string;
  loading: string;
  ctaBar: string;
  ctaCta: string;
  label: string;
  placeholder: string;
  nameLabel: string;
  namePlaceholder: string;
  nameRequired: string;
  captchaRequired: string;
  error: string;
  consentBefore: string;
  consentLinkText: string;
  consentAfter: string;
  consentRequired: string;
}

interface Props {
  ariaLabel: string;
  heading: string;
  sub: string;
  newsletterLabels: NewsletterLabels;
  backgroundImage?: ImageMetadata;
}

const { ariaLabel, heading, sub, newsletterLabels, backgroundImage } = Astro.props;
---

<Section
  background="var(--color-primary)"
  aria-label={ariaLabel}
  paddingBlock="0"
  contentVisibility={false}
  class="newsletter-bar"
  backgroundImage={backgroundImage?.src}
>
  <SectionContainer>
    <div class="newsletter-bar-inner">
      <div class="newsletter-bar-text">
        <TextBlock
          headingLevel="p"
          headingSize="var(--font-size-display)"
          headingWeight="400"
          colorScheme="dark"
          spacing="0"
        >
          <Fragment slot="heading" set:html={heading} />
        </TextBlock>
        <p class="newsletter-bar-sub">{sub}</p>
      </div>
      <div class="newsletter-bar-form">
        <NewsletterForm
          client:visible
          variant="bar"
          captchaSiteKey={import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY ?? ''}
          labels={newsletterLabels}
        />
      </div>
    </div>
  </SectionContainer>
</Section>

<style>
  .newsletter-bar-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 3rem;
    min-block-size: 191px;
    justify-content: center;
  }

  .newsletter-bar-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .newsletter-bar-sub {
    margin: 0;
    font-size: var(--font-size-h4);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-on-dark);
  }

  /* Side-by-side only above 1200px, where the heading + 30.5rem form fit
     without wrapping. The form is fixed-width and never wraps below the
     heading; the heading column shrinks instead. Both columns are pinned to
     the top so the title sits at the top edge, aligned with the form. */
  @media (min-width: 1200px) {
    .newsletter-bar-inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .newsletter-bar-text {
      min-inline-size: 0;
    }
  }

  .newsletter-bar-form {
    inline-size: 100%;
  }

  @media (min-width: 1200px) {
    .newsletter-bar-form {
      inline-size: 30.5rem;
      flex-shrink: 0;
    }
  }
</style>
