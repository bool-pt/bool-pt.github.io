---
import NewsletterForm from '../../compositions/NewsletterForm/NewsletterForm';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';
import TextBlock from '../../primitives/TextBlock/TextBlock.astro';

interface NewsletterLabels {
  subscribed: string;
  loading: string;
  ctaBar: string;
  ctaCta: string;
  label: string;
  placeholder: string;
  captchaRequired: string;
  error: string;
}

interface Props {
  ariaLabel: string;
  heading: string;
  sub: string;
  newsletterLabels: NewsletterLabels;
}

const { ariaLabel, heading, sub, newsletterLabels } = Astro.props;
---

<Section
  background="var(--color-primary)"
  aria-label={ariaLabel}
  paddingBlock="0"
  contentVisibility={false}
  class="newsletter-bar"
>
  <SectionContainer>
    <div class="newsletter-bar-inner">
      <TextBlock
        headingLevel="p"
        headingSize="var(--font-size-display)"
        headingWeight="400"
        bodySize="var(--font-size-h4)"
        colorScheme="dark"
        spacing="0.75rem"
      >
        <Fragment slot="heading" set:html={heading} />
        <p>{sub}</p>
      </TextBlock>
      <div class="newsletter-bar-form">
        <NewsletterForm
          client:visible
          variant="bar"
          captchaSiteKey={import.meta.env.PUBLIC_HCAPTCHA_SITE_KEY ?? ''}
          labels={newsletterLabels}
        />
      </div>
    </div>
  </SectionContainer>
</Section>

<style>
  .newsletter-bar-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 3rem;
    min-block-size: 191px;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .newsletter-bar-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .newsletter-bar-form {
    inline-size: 100%;
  }

  @media (min-width: 768px) {
    .newsletter-bar-form {
      inline-size: 30.5rem;
      flex-shrink: 0;
    }
  }

  .newsletter-bar-inner :global(.text-block--dark .text-block-body p) {
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-on-dark);
  }
</style>
