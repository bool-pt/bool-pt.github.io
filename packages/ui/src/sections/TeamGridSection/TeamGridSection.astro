---
import type { TeamGridPayload } from '@bool/content';
import IntroGridSection from '../../compositions/IntroGridSection/IntroGridSection.astro';
import PersonCard from '../../compositions/PersonCard/PersonCard.astro';

interface Props {
  payload: TeamGridPayload;
}

const { payload } = Astro.props;
const { labels, members } = payload;
---

<IntroGridSection
  headingId="team-heading"
  background="var(--color-surface-warm-dark)"
  colorScheme="dark"
  introAlign="center"
  descriptionMaxWidth="38rem"
  paddingBlock="5rem"
  class="team-section"
>
  <Fragment slot="heading">{labels.heading}</Fragment>
  <Fragment slot="description">{labels.body}</Fragment>

  {
    members.map((member) => (
      <PersonCard
        name={member.name}
        role={member.role}
        photo={member.image}
        linkedin={member.linkedin}
        email={member.email}
        bio={member.bio}
        quote={member.quote}
        tags={member.tags}
        emailAriaPrefix={labels.emailAriaPrefix}
        linkedinAriaSuffix={labels.linkedinAriaSuffix}
        colorScheme="dark"
        variant="card"
      />
    ))
  }
</IntroGridSection>

<style>
  @media (min-width: 1024px) {
    :global(.team-section) {
      min-block-size: 1808px;
    }
  }
</style>
