---
import type { CaseStudiesPayload } from '@bool/content';
import { ROUTES } from '@bool/shared';
import SectionIntro from '../../compositions/SectionIntro/SectionIntro.astro';
import SectionTag from '../../compositions/SectionTag/SectionTag.astro';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';
import CaseStudyGrid from './CaseStudyGrid';

interface Props {
  payload: CaseStudiesPayload;
  backgroundImage?: ImageMetadata;
}

const { payload, backgroundImage } = Astro.props;
const { labels, sectors, techFilters, items } = payload;

// Resolve ImageMetadata to a URL string for the React island (which uses <img src>).
const cases = items.map((item) => ({
  client: item.client,
  title: item.title,
  subtitle: item.subtitle,
  coverImageSrc: item.coverImage.src,
  sector: item.sector,
  tech: item.tech,
  techKey: item.techKey,
  backHeader: item.backHeader,
  modalSubheading: item.modalSubheading,
  metrics: item.metrics,
  challenge: item.challenge,
  solution: item.solution,
  benefits: item.benefits,
  team: item.team,
  duration: item.duration,
  tags: item.tags,
}));
---

<Section
  background="var(--color-background)"
  aria-labelledby="case-studies-heading"
  paddingBlock="4rem 0"
  class="case-studies-section"
  backgroundImage={backgroundImage?.src}
>
  <SectionContainer>
    <SectionIntro
      headingId="case-studies-heading"
      align="start"
      descriptionMaxWidth="42rem"
      marginBlockEnd="1.5rem"
      headingSize="48px"
      bodySize="22px"
      bodyWeight="500"
      bodyLineHeight="28px"
      class="case-studies-intro"
    >
      <SectionTag slot="tag" tagColor="primary">{labels.tag}</SectionTag>
      <Fragment slot="heading">{labels.heading}</Fragment>
      <Fragment slot="description">{labels.body}</Fragment>
    </SectionIntro>

    <CaseStudyGrid
      client:visible
      cases={cases}
      sectors={sectors}
      techFilters={techFilters}
      labels={{
        close: labels.close,
        fullCaseStudy: labels.fullCaseStudyCta,
        emptyMessage: labels.emptyState,
        filterAriaLabel: labels.filterAriaLabel,
        challenge: labels.challengeLabel,
        solution: labels.solutionLabel,
        techStack: labels.techStackLabel,
        talkToExpert: labels.talkToExpertCta,
        backToCases: labels.backToCases,
        ctaHref: ROUTES.contacts,
      }}
    />
  </SectionContainer>
</Section>

<style>
  .case-studies-section {
    block-size: 1006px;
    overflow: hidden;
  }

  :global(.case-studies-intro .section-intro-heading) {
    margin-block-start: 0;
    line-height: 54px;
  }

  /* Skeleton shown while the (client:visible) grid island mounts + shuffles.
     These styles are global and live in the page <head>, so the skeleton is
     always styled — unlike the island's CSS-module cards, which load with the
     island's JS. Layout mirrors FilterableGrid so there's no shift on reveal. */
  :global(.cs-skeleton-pills) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 1.5rem;
  }

  :global(.cs-skeleton-pill) {
    inline-size: 5.5rem;
    block-size: 2.25rem;
    border-radius: 8px;
    background-color: var(--color-muted);
    animation: cs-skeleton-pulse 1.4s ease-in-out infinite;
  }

  :global(.cs-skeleton-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--white-50);
    margin-inline: -1.5rem;
  }

  :global(.cs-skeleton-card) {
    aspect-ratio: 480 / 298;
    background-color: var(--color-surface-muted);
    animation: cs-skeleton-pulse 1.4s ease-in-out infinite;
  }

  @media (min-width: 640px) {
    :global(.cs-skeleton-grid) {
      margin-inline: -7rem;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    :global(.cs-skeleton-grid) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @keyframes cs-skeleton-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.cs-skeleton-pill),
    :global(.cs-skeleton-card) {
      animation: none;
    }
  }
</style>
