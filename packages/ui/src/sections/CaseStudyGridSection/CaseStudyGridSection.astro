---
import type { CaseStudiesPayload } from '@bool/content';
import { ROUTES } from '@bool/shared';
import SectionIntro from '../../compositions/SectionIntro/SectionIntro.astro';
import SectionTag from '../../compositions/SectionTag/SectionTag.astro';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';
import CaseStudyGrid from './CaseStudyGrid';

interface Props {
  payload: CaseStudiesPayload;
  backgroundImage?: ImageMetadata;
}

const { payload, backgroundImage } = Astro.props;
const { labels, sectors, techFilters, items } = payload;

// Resolve ImageMetadata to a URL string for the React island (which uses <img src>).
const cases = items.map((item) => ({
  client: item.client,
  title: item.title,
  subtitle: item.subtitle,
  coverImageSrc: item.coverImage.src,
  sector: item.sector,
  tech: item.tech,
  backHeader: item.backHeader,
  modalSubheading: item.modalSubheading,
  metrics: item.metrics,
  challenge: item.challenge,
  solution: item.solution,
  benefits: item.benefits,
  team: item.team,
  duration: item.duration,
  tags: item.tags,
}));
---

<Section
  background="var(--color-background)"
  aria-labelledby="case-studies-heading"
  id="case-studies"
  paddingBlock="4rem 0"
  class="case-studies-section"
  backgroundImage={backgroundImage?.src}
>
  <SectionContainer>
    <SectionIntro
      headingId="case-studies-heading"
      align="start"
      descriptionMaxWidth="42rem"
      marginBlockEnd="1.5rem"
      headingSize="48px"
      bodySize="22px"
      bodyWeight="500"
      bodyLineHeight="28px"
      class="case-studies-intro"
    >
      <SectionTag slot="tag" tagColor="primary">{labels.tag}</SectionTag>
      <Fragment slot="heading">{labels.heading}</Fragment>
      <Fragment slot="description">{labels.body}</Fragment>
    </SectionIntro>

    <CaseStudyGrid
      client:visible
      cases={cases}
      sectors={sectors}
      techFilters={techFilters}
      labels={{
        close: labels.close,
        fullCaseStudy: labels.fullCaseStudyCta,
        emptyMessage: labels.emptyState,
        filterAriaLabel: labels.filterAriaLabel,
        challenge: labels.challengeLabel,
        solution: labels.solutionLabel,
        techStack: labels.techStackLabel,
        talkToExpert: labels.talkToExpertCta,
        backToCases: labels.backToCases,
        ctaHref: ROUTES.contacts,
      }}
    />
  </SectionContainer>
</Section>

<style>
  .case-studies-section {
    block-size: 1006px;
    overflow: hidden;
  }

  :global(.case-studies-intro .section-intro-heading) {
    margin-block-start: 0;
    line-height: 54px;
  }
</style>
