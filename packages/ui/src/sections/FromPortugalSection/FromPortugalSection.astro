---
import office1 from '@bool/media/images/sections/about/about-02.jpg';
import office3 from '@bool/media/images/sections/about/about-02.jpg';
import office2 from '@bool/media/images/sections/about/about-03.jpg';
import office4 from '@bool/media/images/sections/about/about-03.jpg';
import OfficeCarousel from '../../compositions/OfficeCarousel/OfficeCarousel';
import SectionIntro from '../../compositions/SectionIntro/SectionIntro.astro';
import Section from '../../primitives/Section/Section.astro';
import SectionContainer from '../../primitives/SectionContainer/SectionContainer.astro';

interface Props {
  heading: string;
  description: string;
  offices: Array<{ city: string; building: string; address: string }>;
  carouselAriaLabels: { prev: string; next: string; imageAlt: string };
}

const { heading, description, offices: officeData, carouselAriaLabels } = Astro.props;

const officeImages = [office1.src, office2.src, office3.src, office4.src];

const offices = officeData.map((office, i) => ({
  ...office,
  image: officeImages[i % officeImages.length],
}));
---

<Section aria-labelledby="portugal-heading" paddingBlock="5rem" background="var(--color-surface-light)">
  <SectionContainer>
    <div class="portugal-header">
      <SectionIntro
        headingId="portugal-heading"
        colorScheme="light"
        align="center"
        descriptionMaxWidth="50rem"
        marginBlockEnd="3rem"
        bodySize="1.375rem"
      >
        <Fragment slot="heading">{heading}</Fragment>
        <Fragment slot="description">{description}</Fragment>
      </SectionIntro>
    </div>

    <OfficeCarousel
      offices={offices}
      navPosition="top-right"
      client:visible
      ariaLabels={carouselAriaLabels}
    />
  </SectionContainer>
</Section>

<style>
  .portugal-header {
    position: relative;
  }
</style>
