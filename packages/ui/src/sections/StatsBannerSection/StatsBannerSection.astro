---
import bannerImgFallback from '@bool/media/images/backgrounds/services-banner.jpg';
import ImageTextBanner from '../../compositions/ImageTextBanner/ImageTextBanner.astro';
import Section from '../../primitives/Section/Section.astro';

interface Props {
  ariaLabel: string;
  imageAlt: string;
  quote: string;
  tagline: string;
  backgroundImage?: ImageMetadata;
}

const { ariaLabel, imageAlt, quote, tagline, backgroundImage = bannerImgFallback } = Astro.props;
---

<Section
  background="var(--color-primary)"
  aria-label={ariaLabel}
  paddingBlock="0"
>
  <ImageTextBanner
    image={backgroundImage}
    imageAlt={imageAlt}
    height="330px"
    grayscale
    contentPadding="0 4rem 0 3rem"
  >
    <div class="statsBannerText">
      <p class="statsBannerQuote">{quote}</p>
      <p class="statsBannerTagline">{tagline}</p>
    </div>
  </ImageTextBanner>
</Section>

<style>
  .statsBannerText {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .statsBannerQuote {
    font-family: var(--font-display);
    font-size: var(--font-size-sub);
    font-weight: 600;
    color: var(--color-on-dark);
    line-height: 1.6;
    margin: 0;
  }

  .statsBannerTagline {
    font-family: var(--font-display);
    font-size: var(--font-size-h4);
    font-weight: 700;
    color: var(--color-on-dark);
    line-height: 1.3;
    margin: 0;
  }
</style>
