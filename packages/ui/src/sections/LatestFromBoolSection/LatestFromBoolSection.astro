---
import img01Fallback from '@bool/media/images/covers/insight-01.jpg';
import img02Fallback from '@bool/media/images/covers/insight-02.jpg';
import img03Fallback from '@bool/media/images/covers/insight-03.jpg';
import ArrowLink from '../../compositions/ArrowLink/ArrowLink.astro';
import ImageOverlayCard from '../../compositions/ImageOverlayCard/ImageOverlayCard.astro';
import IntroGridSection from '../../compositions/IntroGridSection/IntroGridSection.astro';
import SectionTag from '../../compositions/SectionTag/SectionTag.astro';
import CardImageBg from '../../primitives/CardImageBg/CardImageBg.astro';
import CardLabel from '../../primitives/CardLabel/CardLabel.astro';
import CardTitle from '../../primitives/CardTitle/CardTitle.astro';

interface Props {
  tag: string;
  heading: string;
  body: string;
  featured: Array<{ category: string; title: string; meta: string; cta: string; href: string; image?: string }>;
}

const { tag, heading, body, featured } = Astro.props;

const fallbackImages = [img01Fallback, img02Fallback, img03Fallback];
---

<IntroGridSection
  headingId="latest-heading"
  background="var(--color-muted)"
  introAlign="start"
  descriptionMaxWidth="36rem"
  gridColumns={3}
  gridCollapseAt="md"
>
  <SectionTag slot="tag">{tag}</SectionTag>
  <Fragment slot="heading">{heading}</Fragment>
  <Fragment slot="description">{body}</Fragment>

  {
    featured.map((item, i) => (
      <ImageOverlayCard
        aspectRatio="384/470"
        gradient="linear-gradient(to top, var(--black-75) 0%, var(--black-20) 50%, transparent 70%)"
        hoverEffect="lift"
      >
        <CardImageBg slot="image" src={item.image ?? (fallbackImages[i % fallbackImages.length] as ImageMetadata).src} />
        <CardLabel colorScheme="on-dark" class="latest-card-label">
          {item.category}
        </CardLabel>
        <CardTitle colorScheme="dark" class="latest-card-title">
          {item.title}
        </CardTitle>
        <span class="latest-card-meta">{item.meta}</span>
        <ArrowLink href={item.href} label={item.cta} colorScheme="dark" />
      </ImageOverlayCard>
    ))
  }
</IntroGridSection>

<style>
  :global(.latest-card-label) {
    margin-block-end: 0.5rem;
  }

  :global(.latest-card-title) {
    margin-block-end: 0.5rem;
  }

  .latest-card-meta {
    font-size: var(--font-size-body-sm);
    color: var(--color-on-dark-muted);
    margin-block-start: 0.75rem;
    margin-block-end: 1.5rem;
  }
</style>
