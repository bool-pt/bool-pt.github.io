---
interface Props {
  size?: number;
  label?: string;
  colorScheme?: 'light' | 'dark';
  class?: string;
}

const { size = 48, label, colorScheme = 'light', class: className } = Astro.props;
const hasCustomIcon = Astro.slots.has('icon');
---

<div class:list={['image-placeholder', `image-placeholder--${colorScheme}`, className]}>
  {
    hasCustomIcon ? (
      <slot name="icon" />
    ) : (
      <svg
        width={size}
        height={size}
        viewBox="0 0 48 48"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect
          x="6"
          y="10"
          width="36"
          height="28"
          rx="3"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
        />
        <circle cx="17" cy="21" r="4" stroke="currentColor" stroke-width="2" fill="none" />
        <path
          d="M6 32l10-8 8 6 8-10 10 12"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {label && <span class="image-placeholder-label">{label}</span>}
</div>

<style>
  .image-placeholder {
    inline-size: 100%;
    block-size: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .image-placeholder--light {
    color: var(--color-muted-foreground);
  }

  .image-placeholder--dark {
    color: var(--white-30);
  }

  .image-placeholder-label {
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .image-placeholder--light .image-placeholder-label {
    color: var(--color-muted-foreground);
  }

  .image-placeholder--dark .image-placeholder-label {
    color: var(--white-25);
  }
</style>
