---
interface Props {
  src?: string;
  fallbackColor?: string;
  fallbackGradient?: string;
  class?: string;
}

const {
  src,
  fallbackColor = 'var(--color-surface-dark)',
  fallbackGradient,
  class: className,
} = Astro.props;

const style = [
  `background-color: ${fallbackColor}`,
  src ? `background-image: url(${src})` : null,
  fallbackGradient && !src ? `background-image: ${fallbackGradient}` : null,
]
  .filter(Boolean)
  .join('; ');
---

<div class:list={['card-image-bg', className]} style={style} aria-hidden="true"></div>

<style>
  .card-image-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
</style>
