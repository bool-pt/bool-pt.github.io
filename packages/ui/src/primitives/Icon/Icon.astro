---
import { iconPaths, type IconName } from './icon-data';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.5, class: className } = Astro.props;

const icon = iconPaths[name];
const viewBox = icon.viewBox ?? '0 0 24 24';
---

{
  icon.mode === 'stroke' && (
    <svg
      width={size}
      height={size}
      viewBox={viewBox}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={className}
    >
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

{
  icon.mode === 'fill' && (
    <svg
      width={size}
      height={size}
      viewBox={viewBox}
      fill="currentColor"
      aria-hidden="true"
      class={className}
    >
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

{
  icon.mode === 'mixed' && (
    <svg width={size} height={size} viewBox={viewBox} aria-hidden="true" class={className}>
      {icon.paths.map((p) => (
        <path
          d={p.d}
          fill={p.fill ?? 'none'}
          stroke={p.stroke ?? 'none'}
          stroke-width={p.stroke !== 'none' ? strokeWidth : undefined}
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      ))}
    </svg>
  )
}
