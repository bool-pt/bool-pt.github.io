const def = letters[letter];
const aspectRatio = def.nativeWidth / def.nativeHeight;
const width = Math.round(height * aspectRatio * 100) / 100;
---

<svg
  width={width}
  height={height}
  viewBox={def.viewBox}
  fill={def.fill}
  aria-hidden="true"
  class:list={['brand-letter', className]}
>
  {
    def.paths.map((p) => (
      <path
        d={p.d}
        fill={p.fill ?? 'none'}
        stroke={p.stroke ?? 'none'}
        stroke-width={p.stroke && def.strokeWidth ? def.strokeWidth : undefined}
      />
    ))
  }
</svg>

<style>
  .brand-letter {
    inline-size: auto;
    block-size: auto;
  }
</style>
