---
interface Props {
  value: string;
  label: string;
  colorScheme?: 'light' | 'dark';
  class?: string;
}

const { value, label, colorScheme = 'dark', class: className } = Astro.props;
---

<div class:list={['stat-item', `stat-item--${colorScheme}`, className]}>
  <span class="stat-value">{value}</span>
  <span class="stat-label">{label}</span>
</div>

<style>
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--stat-gap, 0.25rem);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--stat-value-size, var(--font-size-h1));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--stat-value-tracking, 0);
  }

  .stat-label {
    font-size: var(--stat-label-size, var(--font-size-body-sm));
    font-weight: var(--stat-label-weight, 500);
    text-transform: var(--stat-label-transform, uppercase);
    letter-spacing: var(--stat-label-tracking, 0.06em);
  }

  .stat-item--dark .stat-value {
    color: var(--color-on-dark);
  }

  .stat-item--dark .stat-label {
    color: var(--color-on-dark-muted);
  }

  .stat-item--light .stat-value {
    color: var(--color-foreground);
  }

  .stat-item--light .stat-label {
    color: var(--color-muted-foreground);
  }
</style>
