---
interface Props {
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4' | 'p';
  headingId?: string;
  headingSize?: string;
  headingWeight?: string;
  bodySize?: string;
  bodyMaxWidth?: string;
  bodyLineHeight?: string;
  spacing?: string;
  colorScheme?: 'light' | 'dark';
  class?: string;
}

const {
  headingLevel = 'h2',
  headingId,
  headingSize,
  headingWeight,
  bodySize,
  bodyMaxWidth,
  bodyLineHeight,
  spacing,
  colorScheme = 'light',
  class: className,
} = Astro.props;

const HeadingTag = headingLevel;
const hasBody = Astro.slots.has('default');

const wrapperStyle =
  [
    headingSize ? `--tb-heading-size: ${headingSize}` : null,
    headingWeight ? `--tb-heading-weight: ${headingWeight}` : null,
    bodySize ? `--tb-body-size: ${bodySize}` : null,
    bodyMaxWidth ? `--tb-body-max-width: ${bodyMaxWidth}` : null,
    bodyLineHeight ? `--tb-body-line-height: ${bodyLineHeight}` : null,
    spacing ? `--tb-spacing: ${spacing}` : null,
  ]
    .filter(Boolean)
    .join('; ') || undefined;
---

<div class:list={['text-block', `text-block--${colorScheme}`, className]} style={wrapperStyle}>
  <HeadingTag id={headingId} class="text-block-heading">
    <slot name="heading" />
  </HeadingTag>
  {
    hasBody && (
      <div class="text-block-body">
        <slot />
      </div>
    )
  }
</div>

<style>
  .text-block-heading {
    font-family: var(--font-display);
    font-size: var(--tb-heading-size, var(--font-size-display));
    font-weight: var(--tb-heading-weight, 700);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 var(--tb-spacing, 1.5rem);
  }

  .text-block-heading :global(strong) {
    font-weight: 700;
  }

  .text-block-body {
    max-inline-size: var(--tb-body-max-width);
  }

  .text-block-body :global(p) {
    font-size: var(--tb-body-size, var(--font-size-body));
    font-weight: 500;
    line-height: var(--tb-body-line-height, 1.65);
    margin: 0 0 1rem;
  }

  .text-block-body :global(p:last-child) {
    margin-block-end: 0;
  }

  .text-block--light .text-block-heading {
    color: var(--color-surface-dark);
  }

  .text-block--light .text-block-body :global(p) {
    color: var(--color-muted-foreground);
  }

  .text-block--dark .text-block-heading {
    color: var(--color-on-dark);
  }

  .text-block--dark .text-block-body :global(p) {
    color: var(--color-on-dark-muted);
  }
</style>
