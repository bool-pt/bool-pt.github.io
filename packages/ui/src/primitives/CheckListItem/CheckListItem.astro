---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<li class:list={['check-item', className]}>
  <span class="check-icon" aria-hidden="true">
    <svg
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6L9 17l-5-5"></path>
    </svg>
  </span>
  <span><slot /></span>
</li>

<style>
  .check-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .check-icon {
    flex-shrink: 0;
    inline-size: 1.375rem;
    block-size: 1.375rem;
    border-radius: 50%;
    background-color: var(--color-success);
    color: var(--color-on-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--check-border, none);
  }
</style>
