---
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'ghost' | 'on-dark';
  iconLeft?: boolean;
  iconRight?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  iconLeft = false,
  iconRight = false,
  class: className,
} = Astro.props;

import Icon from '../Icon/Icon.astro';
---

<a href={href} class:list={['btn-link', `btn-link--${variant}`, className]}>
  {iconLeft && <Icon name="arrow-left" size={18} strokeWidth={2.5} class="btn-link-icon" />}
  <slot />
  {iconRight && <Icon name="arrow-right" size={18} strokeWidth={2.5} class="btn-link-icon" />}
</a>

<style>
  .btn-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    block-size: 48px;
    padding-inline: 2rem;
    font-size: var(--font-size-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: 28px;
    transition:
      background-color 150ms,
      border-color 150ms,
      box-shadow 150ms;
  }

  .btn-link-icon {
    flex-shrink: 0;
  }

  .btn-link--primary {
    background-color: var(--color-primary);
    color: var(--color-on-dark);
    border: 2px solid var(--color-primary);
  }

  .btn-link--primary:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .btn-link--outline {
    background-color: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .btn-link--outline:hover {
    background-color: var(--color-primary);
    color: var(--color-on-dark);
  }

  .btn-link--ghost {
    padding-inline: 1.25rem;
    background-color: var(--color-border-on-dark);
    color: var(--color-on-dark-muted);
    font-size: var(--font-size-body-sm);
    border: 1px solid var(--white-12);
  }

  .btn-link--ghost:hover {
    background-color: var(--white-14);
    color: var(--color-on-dark);
  }

  .btn-link--on-dark {
    background-color: transparent;
    color: var(--color-on-dark);
    border: 2px solid var(--color-on-dark);
  }

  .btn-link--on-dark:hover {
    background-color: var(--color-on-dark);
    color: var(--color-surface-dark);
  }
</style>
