---
interface Props {
  class?: string;
  style?: string;
}

const { class: className, style } = Astro.props;
---

<div class:list={['section-container', className]} style={style}>
  <slot />
</div>

<style>
  .section-container {
    inline-size: 100%;
    max-inline-size: 1440px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 640px) {
    .section-container {
      padding-inline: 7rem;
    }
  }
</style>
