---
interface Props {
  tagColor?: 'primary' | 'muted' | 'on-dark-muted';
  class?: string;
}

const { tagColor = 'primary', class: className } = Astro.props;
---

<div class:list={['section-tag', `section-tag--${tagColor}`, className]}>
  <span class="tag-line"></span>
  <span class="tag-text"><slot /></span>
</div>

<style>
  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1rem;
  }

  .tag-line {
    display: block;
    inline-size: 24px;
    block-size: 2px;
    background-color: var(--color-primary);
  }

  .tag-text {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .section-tag--primary .tag-text {
    color: var(--color-primary);
  }

  .section-tag--muted .tag-text {
    color: var(--color-muted-foreground);
  }

  .section-tag--on-dark-muted .tag-text {
    color: var(--color-on-dark-muted);
  }
</style>
