---
import ButtonLink from '../../primitives/ButtonLink/ButtonLink.astro';
import CardLabel from '../../primitives/CardLabel/CardLabel.astro';
import CardTitle from '../../primitives/CardTitle/CardTitle.astro';

interface Props {
  category: string;
  title: string;
  stats: Array<{ value: string; label: string }>;
  ctaLabel: string;
  ctaHref: string;
  class?: string;
}

const { category, title, stats, ctaLabel, ctaHref, class: className } = Astro.props;
---

<article class:list={['featured-stats-card', className]}>
  <CardLabel style="margin-block-end: 0.5rem">{category}</CardLabel>
  <CardTitle size="var(--font-size-lead)" class="featured-stats-card-title">{title}</CardTitle>
  <div class="featured-stats-card-row">
    {
      stats.map((stat) => (
        <div class="featured-stats-card-stat">
          <span class="featured-stats-card-value">{stat.value}</span>
          <span class="featured-stats-card-label">{stat.label}</span>
        </div>
      ))
    }
  </div>
  <ButtonLink href={ctaHref} variant="primary" class="featured-stats-card-btn"
    >{ctaLabel}</ButtonLink
  >
</article>

<style>
  .featured-stats-card {
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-stats-card-title {
    margin-block-end: 1.25rem;
  }

  .featured-stats-card-row {
    display: flex;
    gap: 2rem;
    margin-block-end: 1.5rem;
  }

  .featured-stats-card-stat {
    display: flex;
    flex-direction: column;
  }

  .featured-stats-card-value {
    font-size: var(--font-size-body-lg);
    font-weight: 700;
    color: var(--color-foreground);
  }

  .featured-stats-card-label {
    font-size: var(--font-size-body-sm);
    color: var(--color-muted-foreground);
  }
</style>
