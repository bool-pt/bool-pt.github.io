---
import ButtonLink from '../../primitives/ButtonLink/ButtonLink.astro';
import Tag from '../../primitives/Tag/Tag.astro';

interface Props {
  date: string;
  tag: string;
  tagColor?: string;
  title: string;
  description: string;
  descriptionLabel?: string;
  location?: string;
  meetCta?: string;
  meetHref?: string;
  class?: string;
}

const {
  date,
  tag,
  tagColor,
  title,
  description,
  descriptionLabel,
  location,
  meetCta,
  meetHref,
  class: className,
} = Astro.props;
---

<article class:list={['event-item', className]}>
  <div class="event-main">
    <div class="event-header">
      <Tag
        variant="filled"
        colorScheme="primary"
        class="event-tag"
        style={tagColor ? `background-color: ${tagColor}` : undefined}>{tag}</Tag
      >
      <span class="event-title">{title}</span>
    </div>
    {descriptionLabel && <p class="event-desc-label">{descriptionLabel}</p>}
    <p class="event-desc">{description}</p>
    {location && <p class="event-location">{location}</p>}
  </div>

  <div class="event-side">
    <span class="event-date">{date}</span>
    {
      meetCta && (
        <ButtonLink
          href={meetHref ?? '#'}
          variant="primary"
          class="event-cta event-schedule-trigger"
        >
          {meetCta}
        </ButtonLink>
      )
    }
  </div>
</article>

<style>
  .event-item {
    display: flex;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-block-end: 1px solid var(--color-border);
  }

  .event-item:first-child {
    padding-block-start: 0;
  }

  .event-item:last-child {
    border-block-end: none;
  }

  .event-main {
    flex: 1;
    min-inline-size: 0;
  }

  .event-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 0.5rem;
  }

  .event-header :global(.tag) {
    font-size: var(--font-size-body-sm);
    padding-block: 0.375rem;
    padding-inline: 0.875rem;
  }

  .event-title {
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--color-surface-dark);
  }

  .event-desc-label {
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-surface-dark);
    margin: 0 0 0.25rem;
  }

  .event-desc {
    font-size: var(--font-size-body-sm);
    color: var(--color-foreground);
    line-height: 1.6;
    margin: 0;
  }

  .event-location {
    font-size: var(--font-size-body-sm);
    color: var(--color-foreground);
    margin: 0.5rem 0 0;
  }

  .event-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-shrink: 0;
  }

  .event-date {
    font-size: var(--font-size-body-sm);
    color: var(--color-surface-dark);
    white-space: nowrap;
  }

  .event-cta {
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .event-item {
      flex-direction: column;
      gap: 0.75rem;
    }

    .event-side {
      flex-direction: row-reverse;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
