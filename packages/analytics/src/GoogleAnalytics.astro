---
// GA4 via Partytown — runs off the main thread.
//
// Consent handling lives in @bool/compliance's shared gate (`onConsentGranted` /
// `onConsentRevoked`), which also enforces CONSENT_ENABLED, so GA can never load
// without the UI that lets users withdraw it (GDPR Art. 7(3)).
//
// The script is rendered unconditionally and guards on GA_MEASUREMENT_ID inside:
// Astro hoists bundled <script> tags at build time, so wrapping one in a template
// conditional does not reliably keep it out of the page. Vite inlines the env var,
// so an unconfigured deployment dead-code-eliminates the body.
//
// The googletagmanager/google-analytics preconnects are issued from injectGA()
// rather than rendered in the document head: as head markup they opened a TLS
// connection to Google on every page load, before any consent decision.
---

<script>
  import { onConsentGranted, onConsentRevoked, deleteCookies } from '@bool/compliance';
  import { GA_MEASUREMENT_ID } from './config';

  if (GA_MEASUREMENT_ID) {
    const preconnect = (href: string) => {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = href;
      link.crossOrigin = '';
      document.head.appendChild(link);
    };

    const injectGA = () => {
      if (document.querySelector('script[data-ga-injected]')) return;

      preconnect('https://www.googletagmanager.com');
      preconnect('https://www.google-analytics.com');

      const gtagScript = document.createElement('script');
      gtagScript.async = true;
      gtagScript.type = 'text/partytown';
      gtagScript.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
      gtagScript.setAttribute('data-ga-injected', 'true');
      document.head.appendChild(gtagScript);

      const inlineScript = document.createElement('script');
      inlineScript.type = 'text/partytown';
      inlineScript.textContent =
        'window.dataLayer=window.dataLayer||[];' +
        'function gtag(){dataLayer.push(arguments);}' +
        "gtag('js',new Date());" +
        `gtag('config','${GA_MEASUREMENT_ID}',` +
        // anonymize_ip keeps analytics within the analytics purpose; the signals
        // flags prevent GA from enabling advertising/marketing-grade processing
        // under analytics-only consent.
        '{anonymize_ip:true,allow_google_signals:false,allow_ad_personalization_signals:false});';
      document.head.appendChild(inlineScript);

      // Partytown scans for text/partytown scripts once, at its own startup, and
      // does not observe later DOM changes — so both scripts above stay inert
      // until it is told to rescan. Without this GA never loads at all.
      window.dispatchEvent(new CustomEvent('ptupdate'));
    };

    onConsentGranted('analytics', injectGA);

    onConsentRevoked('analytics', () => {
      deleteCookies(
        (name) => name === '_ga' || name.startsWith('_ga_') || name === '_gid' || name === '_gat'
      );
      // Reloading tears down the running gtag worker (and Sentry) for the rest of
      // the session — there is no supported way to unload Partytown in place.
      location.reload();
    });
  }
</script>
