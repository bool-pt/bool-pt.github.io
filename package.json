{
  "name": "bool",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@bool/web",
    "dev:json-editor": "turbo dev --filter=@bool/json-editor",
    "build": "turbo build",
    "lint": "turbo lint",
    "knip": "knip --config tooling/knip.config.ts",
    "freshness": "node tooling/scripts/check-dep-freshness.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "test:e2e": "pnpm -F @bool/e2e e2e",
    "typecheck": "turbo typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bool/eslint-config": "workspace:*",
    "@bool/prettier-config": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "knip": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ],
    "packages/i18n/src/locales/*.json": [
      "pnpm -F @bool/content vitest run src/validation.test.ts src/case-studies.test.ts src/team-grid.test.ts --"
    ],
    "packages/media/images/**/*": [
      "pnpm -F @bool/content vitest run src/validation.test.ts --"
    ]
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.28.0 <8",
      "fast-uri": ">=3.1.2 <4",
      "js-yaml": ">=4.2.0 <5",
      "@babel/core": ">=7.29.7 <8",
      "postcss": ">=8.5.10",
      "esbuild": ">=0.28.1",
      "yaml": ">=2.8.3"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
