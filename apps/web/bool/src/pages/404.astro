---
import { t } from '@bool/i18n';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import { getHeaderLabels, getFooterLabels } from '../labels';
---

<BaseLayout
  title={t('notFound.title')}
  description={t('notFound.description')}
  noindex
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  <section
    style="display: grid; place-items: center; min-block-size: 60vh; text-align: center; padding: 2rem;"
  >
    <div>
      <h1
        style="font-size: var(--font-size-mega); font-weight: 800; line-height: 1; margin-block-end: 1rem;"
      >
        {t('notFound.heading')}
      </h1>
      <p
        style="font-size: var(--font-size-body-lg); color: var(--color-muted-foreground); margin-block-end: 2rem;"
      >
        {t('notFound.message')}
      </p>
      <a
        href="/"
        style="display: inline-flex; align-items: center; padding: 0.625rem 1.5rem; background-color: var(--color-primary); color: var(--color-primary-foreground); border-radius: 0.375rem; font-size: var(--font-size-body-sm); font-weight: 500; text-decoration: none;"
      >
        {t('notFound.cta')}
      </a>
    </div>
  </section>
</BaseLayout>
