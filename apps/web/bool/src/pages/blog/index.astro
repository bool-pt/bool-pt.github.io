---
import { getEvents, resolveImage, transformEvent } from '@bool/content';
import { t, tCollection, tList } from '@bool/i18n';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import ContactSection from '@bool/ui/sections/ContactSection.astro';
import EventsCalendarSection from '@bool/ui/sections/EventsCalendarSection.astro';
import InsightsCTASection from '@bool/ui/sections/InsightsCTASection.astro';
import InsightsHeroSection from '@bool/ui/sections/InsightsHeroSection.astro';
import KnowledgeCenterSection from '@bool/ui/sections/KnowledgeCenterSection.astro';
import LatestFromBoolSection from '@bool/ui/sections/LatestFromBoolSection.astro';
import NewsletterCTASection from '@bool/ui/sections/NewsletterCTASection.astro';
import NewsUpdatesSection from '@bool/ui/sections/NewsUpdatesSection.astro';
import PressReleasesSection from '@bool/ui/sections/PressReleasesSection.astro';
import {
  getHeaderLabels,
  getFooterLabels,
  getContactSectionProps,
  getNewsletterLabels,
  getCalendarLabels,
} from '../../labels';

const events = await getEvents();
const eventItems = events.slice(0, 3).map(transformEvent);

const latestFeatured = tCollection('latestPosts.item', [
  'category',
  'title',
  'author',
  'readTime',
  'date',
  'location',
  'cta',
  'image',
]).map((item) => ({
  category: item.category,
  title: item.title,
  meta: [item.author, item.readTime, item.date, item.location]
    .filter((v) => v && !v.startsWith('latestPosts.'))
    .join(' · '),
  cta: item.cta,
  href: '/blog',
  image: resolveImage(item.image).src,
}));

const knowledgeFilters = tList('knowledgeCenter.filters');

const knowledgeArticles = tCollection('knowledgeCenter.article', [
  'category',
  'title',
  'author',
  'readTime',
  'views',
  'subtitle',
  'challenge',
  'solution',
  'techStack',
  'image',
  'publishDate',
  'authorAvatar',
]).map((a, i) => ({
  category: a.category,
  title: a.title,
  author: a.author,
  authorAvatar: a.authorAvatar ? resolveImage(a.authorAvatar).src : undefined,
  readTime: a.readTime,
  views: a.views,
  subtitle: a.subtitle,
  challenge: a.challenge,
  solution: a.solution,
  publishDate: a.publishDate,
  href: '/blog',
  tags: t(`knowledgeCenter.tags.${i + 1}`).split(','),
  metrics: tCollection(`knowledgeCenter.article.${i + 1}.metrics`, ['value', 'label']),
  techStack: a.techStack.split(','),
  frontImage: resolveImage(a.image).src,
}));

const newsFilters = tList('newsUpdates.filters');

const newsItems = tCollection('newsUpdates.item', [
  'category',
  'date',
  'title',
  'summary',
  'tags',
  'image',
]).map((item) => ({
  category: item.category,
  date: item.date,
  title: item.title,
  summary: item.summary,
  href: '/blog',
  tags: item.tags.split(','),
  image: resolveImage(item.image).src,
}));

const pressReleases = tCollection('pressReleases.item', ['date', 'title', 'description']).map(
  (p) => ({ ...p, href: '/blog' })
);

const eventCards = tCollection('eventsCalendar.item', [
  'category',
  'title',
  'description',
  'dateInfo',
  'cta',
]).map((e) => ({ ...e, href: '/blog' }));
---

<BaseLayout
  title={t('pageMeta.blog.title')}
  description={t('pageMeta.blog.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  <InsightsHeroSection
    tag={t('insightsHero.tag')}
    heading={t('insightsHero.heading')}
    body={t('insightsHero.body')}
    ctaExplore={t('insightsHero.cta.explore')}
    ctaSubscribe={t('insightsHero.cta.subscribe')}
    backgroundImage={resolveImage(t('insightsHero.backgroundImage'))}
  />
  <LatestFromBoolSection
    tag={t('latestPosts.tag')}
    heading={t('latestPosts.heading')}
    body={t('latestPosts.body')}
    featured={latestFeatured}
  />
  <KnowledgeCenterSection
    tag={t('knowledgeCenter.tag')}
    heading={t('knowledgeCenter.heading')}
    body={t('knowledgeCenter.body')}
    filters={knowledgeFilters}
    articles={knowledgeArticles}
    labels={{
      close: t('common.close'),
      readArticle: t('knowledgeCenter.readArticleCta'),
      readTime: t('knowledgeCenter.readTimeLabel'),
      views: t('knowledgeCenter.viewsLabel'),
      emptyMessage: t('knowledgeCenter.emptyState'),
      filterAriaLabel: t('knowledgeCenter.filter.aria'),
      aboutThisArticle: t('knowledgeCenter.modal.aboutThisArticle'),
      published: t('knowledgeCenter.modal.published'),
      relatedTopics: t('knowledgeCenter.modal.relatedTopics'),
      backToArticles: t('knowledgeCenter.modal.backToArticles'),
      copyLink: t('knowledgeCenter.modal.copyLink'),
      copied: t('knowledgeCenter.modal.copied'),
      shareChannels: [
        { key: 'email', visible: t('knowledgeCenter.share.email.visible') === 'true' },
        { key: 'linkedin', visible: t('knowledgeCenter.share.linkedin.visible') === 'true' },
        { key: 'x', visible: t('knowledgeCenter.share.x.visible') === 'true' },
        { key: 'copyLink', visible: t('knowledgeCenter.share.copyLink.visible') === 'true' },
      ],
    }}
  />
  <NewsUpdatesSection
    tag={t('newsUpdates.tag')}
    heading={t('newsUpdates.heading')}
    body={t('newsUpdates.body')}
    filters={newsFilters}
    newsItems={newsItems}
    labels={{
      readMore: t('common.readMore'),
      emptyMessage: t('newsUpdates.emptyState'),
      filterAriaLabel: t('newsUpdates.filter.aria'),
    }}
  />
  <PressReleasesSection
    tag={t('pressReleases.tag')}
    heading={t('pressReleases.heading')}
    body={t('pressReleases.body')}
    viewMoreLabel={t('pressReleases.cta.viewMore')}
    pressReleases={pressReleases}
  />
  <EventsCalendarSection
    tag={t('eventsCalendar.tag')}
    heading={t('eventsCalendar.heading')}
    body={t('eventsCalendar.body')}
    eventCards={eventCards}
    calendarLabels={getCalendarLabels()}
    events={eventItems}
  />
  <InsightsCTASection
    tag={t('insightsCta.tag')}
    headingLine1={t('insightsCta.heading.line1')}
    headingLine2={t('insightsCta.heading.line2')}
    body={t('insightsCta.body')}
    button={t('insightsCta.button')}
  />
  <ContactSection {...getContactSectionProps()} background="var(--color-surface-black)" />
  <NewsletterCTASection
    heading={t('newsletterCta.heading')}
    body={t('newsletterCta.body')}
    newsletterLabels={getNewsletterLabels()}
  />
</BaseLayout>
