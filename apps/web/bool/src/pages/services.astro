---
import { resolveImage } from '@bool/content';
import { t, tCollection, tList, tOptional } from '@bool/i18n';
import AiUseCasesSection from '@bool/ui/sections/AiUseCasesSection.astro';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import ContactSection from '@bool/ui/sections/ContactSection.astro';
import HowWeWorkSection from '@bool/ui/sections/HowWeWorkSection.astro';
import LetsBuildCTASection from '@bool/ui/sections/LetsBuildCTASection.astro';
import NewsletterCTASection from '@bool/ui/sections/NewsletterCTASection.astro';
import PowerAISection from '@bool/ui/sections/PowerAISection.astro';
import ServicesHeroSection from '@bool/ui/sections/ServicesHeroSection.astro';
import SolutionsROISection from '@bool/ui/sections/SolutionsROISection.astro';
import StatsBannerSection from '@bool/ui/sections/StatsBannerSection.astro';
import TechStackSection from '@bool/ui/sections/TechStackSection.astro';
import {
  getHeaderLabels,
  getFooterLabels,
  getContactSectionProps,
  getNewsletterLabels,
} from '../labels';

const solutions = tCollection('solutionsRoi', ['name', 'result']);

const aiUseCases = tCollection('aiUseCases.items', ['category', 'title', 'image', 'href']).map(
  (item) => ({
    category: item.category,
    title: item.title,
    href: item.href,
    image: resolveImage(item.image).src,
  })
);

const platformKeys = ['outsystems', 'powerplatform', 'mendix', 'opensource'] as const;
const platforms = tCollection('techStack.platforms', [
  'name',
  'expert',
  'role',
  'body',
  'image',
]).map((p, i) => ({
  key: platformKeys[i] ?? '',
  ...p,
  image: resolveImage(p.image),
  features: tList(`techStack.platforms.${i + 1}.features`),
}));

const bgPowerAi = tOptional('powerAi.backgroundImage');
const bgSolutionsRoi = tOptional('solutionsRoi.backgroundImage');
const bgAiUseCases = tOptional('aiUseCases.backgroundImage');
const bgTechStack = tOptional('techStack.backgroundImage');
const bgHowWeWork = tOptional('howWeWork.backgroundImage');
const bgNewsletterCta = tOptional('newsletterCta.backgroundImage');
const bgContactSection = tOptional('contactSection.backgroundImage');

const iconNames = ['shield', 'chart', 'rocket', 'trophy'] as const;
const howWeWorkCards = tCollection('howWeWork.cards', [
  'subtitle',
  'title',
  'description',
  'bullet1',
  'bullet2',
  'bullet3',
]).map((card, i) => ({
  subtitle: card.subtitle,
  title: card.title,
  description: card.description,
  bullets: [card.bullet1, card.bullet2, card.bullet3],
  iconName: iconNames[i] ?? ('shield' as const),
}));
---

<BaseLayout
  title={t('pageMeta.services.title')}
  description={t('pageMeta.services.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  <ServicesHeroSection
    heading={t('servicesHero.heading')}
    body1={t('servicesHero.body1')}
    body2={t('servicesHero.body2')}
    backgroundImage={resolveImage(t('servicesHero.backgroundImage'))}
  />
  <PowerAISection
    showCta={false}
    minBlockSize="401px"
    imageWidth={486}
    imageHeight={241}
    heading={t('aiPitch.heading')}
    body1={t('aiPitch.body1')}
    body2={t('aiPitch.body2')}
    cta={t('powerAi.cta')}
    imageAlt={t('powerAi.image.alt')}
    image={resolveImage(t('powerAi.image'))}
    backgroundImage={bgPowerAi ? resolveImage(bgPowerAi) : undefined}
  />
  <SolutionsROISection
    heading={t('solutionsRoi.heading')}
    colSolutions={t('solutionsRoi.colSolutions')}
    colResults={t('solutionsRoi.colResults')}
    ariaLabel={t('solutionsRoi.aria')}
    solutions={solutions}
    backgroundImage={bgSolutionsRoi ? resolveImage(bgSolutionsRoi) : undefined}
  />
  <AiUseCasesSection
    eyebrow={t('aiUseCases.eyebrow')}
    heading={t('aiUseCases.heading')}
    description={t('aiUseCases.description')}
    ctaLabel={t('aiUseCases.ctaLabel')}
    prevLabel={t('carousel.previous')}
    nextLabel={t('carousel.next')}
    items={aiUseCases}
    backgroundImage={bgAiUseCases ? resolveImage(bgAiUseCases) : undefined}
  />
  <StatsBannerSection
    ariaLabel={t('statsBanner.aiAdoption.aria')}
    imageAlt={t('statsBanner.image.alt')}
    quote={t('statsBanner.quote')}
    tagline={t('statsBanner.tagline')}
    backgroundImage={resolveImage(t('statsBanner.backgroundImage'))}
  />
  <TechStackSection
    readinessExpertName={t('aiReadiness.expertName')}
    readinessExpertRole={t('aiReadiness.expertRole')}
    readinessExpertPhoto={resolveImage(t('aiReadiness.expertImage'))}
    readinessHeading={t('aiReadiness.heading')}
    readinessBody={t('aiReadiness.body')}
    readinessChecks={tList('aiReadiness.checks')}
    readinessCta={t('aiReadiness.cta')}
    techHeading={t('techStack.heading')}
    techBody={t('techStack.body')}
    availableConsultation={t('techStack.availableConsultation')}
    contactExpert={t('techStack.contactExpert')}
    platforms={platforms}
    backgroundImage={bgTechStack ? resolveImage(bgTechStack) : undefined}
  />
  <HowWeWorkSection
    heading={t('howWeWork.heading')}
    cards={howWeWorkCards}
    backgroundImage={bgHowWeWork ? resolveImage(bgHowWeWork) : undefined}
  />
  <LetsBuildCTASection
    heading={t('ctaBanner.heading')}
    body={t('ctaBanner.body')}
    button={t('common.talkToExpert')}
    backgroundImage={resolveImage(t('ctaBanner.backgroundImage'))}
  />
  <ContactSection
    {...getContactSectionProps()}
    background="var(--color-surface-black)"
    backgroundImage={bgContactSection ? resolveImage(bgContactSection) : undefined}
  />
  <NewsletterCTASection
    heading={t('newsletterCta.heading')}
    body={t('newsletterCta.body')}
    newsletterLabels={getNewsletterLabels()}
    backgroundImage={bgNewsletterCta ? resolveImage(bgNewsletterCta) : undefined}
  />
</BaseLayout>
