---
import { t } from '@bool/i18n';
import DarkPageHero from '@bool/ui/compositions/DarkPageHero.astro';
import SectionIntro from '@bool/ui/compositions/SectionIntro.astro';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import CareersCtaSection from '@bool/ui/sections/CareersCtaSection.astro';
import { getHeaderLabels, getFooterLabels } from '../labels';
---

<BaseLayout
  title={t('pageMeta.careers.title')}
  description={t('pageMeta.careers.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  <DarkPageHero aria-label={t('careers.heading')}>
    <SectionIntro headingId="careers-heading" headingLevel="h1" colorScheme="dark">
      <Fragment slot="heading">{t('careers.heading')}</Fragment>
      <p>{t('careers.description')}</p>
    </SectionIntro>
  </DarkPageHero>
  <CareersCtaSection
    tag={t('careersCta.tag')}
    heading={t('careersCta.heading')}
    body={t('careersCta.body')}
    cta={t('careersCta.cta')}
  />
</BaseLayout>
