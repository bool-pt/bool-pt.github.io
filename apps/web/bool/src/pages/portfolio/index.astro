---
import { getCaseStudies, resolveImage } from '@bool/content';
import { t, tCollection } from '@bool/i18n';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import CaseStudyGridSection from '@bool/ui/sections/CaseStudyGridSection.astro';
import CertificationsSection from '@bool/ui/sections/CertificationsSection.astro';
import ClientLogosSection from '@bool/ui/sections/ClientLogosSection.astro';
import ContactSection from '@bool/ui/sections/ContactSection.astro';
import LetsBuildCTASection from '@bool/ui/sections/LetsBuildCTASection.astro';
import NewsletterCTASection from '@bool/ui/sections/NewsletterCTASection.astro';
import PortfolioHeroSection from '@bool/ui/sections/PortfolioHeroSection.astro';
import PortfolioStatsSection from '@bool/ui/sections/PortfolioStatsSection.astro';
import TestimonialsCarouselSection from '@bool/ui/sections/TestimonialsCarouselSection.astro';
import {
  getHeaderLabels,
  getFooterLabels,
  getContactSectionProps,
  getNewsletterLabels,
} from '../../labels';

const caseStudiesPayload = getCaseStudies();

const sectors = t('portfolioHero.sectors').split(',');

const clientTestimonials = tCollection('clientTestimonials', [
  'quote',
  'name',
  'role',
  'avatar',
]).map((item) => ({
  quote: item.quote,
  company: item.name,
  designation: item.role,
  avatar: resolveImage(item.avatar).src,
}));

const portfolioStats = tCollection('portfolioStats.items', ['value', 'label']);

const recognitionIcons = ['trophy', 'chart', 'shield', 'trophy'] as const;
const recognitions = tCollection('portfolioStats.recognition', ['title', 'description']).map(
  (r, i) => ({ ...r, iconName: recognitionIcons[i] ?? ('trophy' as const) })
);

const certifications = tCollection('certifications.items', ['name', 'count', 'logo']).map((c) => ({
  name: c.name,
  count: c.count,
  label: t('certifications.label'),
  logo: c.logo ? resolveImage(c.logo) : null,
}));
---

<BaseLayout
  title={t('pageMeta.portfolio.title')}
  description={t('pageMeta.portfolio.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  <PortfolioHeroSection
    tag={t('portfolioHero.tag')}
    heading={t('portfolioHero.heading')}
    body={t('portfolioHero.body')}
    sectors={sectors}
    ctaStories={t('portfolioHero.cta.stories')}
    ctaServices={t('portfolioHero.cta.services')}
    stats={portfolioStats}
    backgroundImage={resolveImage(t('portfolioHero.backgroundImage'))}
  />
  <CaseStudyGridSection payload={caseStudiesPayload} />
  <TestimonialsCarouselSection
    tag={t('clientTestimonials.tag')}
    heading={t('clientTestimonials.heading')}
    body={t('clientTestimonials.body')}
    testimonials={clientTestimonials}
    carouselAriaLabels={{ prev: t('carousel.previous'), next: t('carousel.next') }}
  />
  <PortfolioStatsSection
    tag={t('portfolioStats.tag')}
    heading={t('portfolioStats.heading')}
    body={t('portfolioStats.body')}
    stats={portfolioStats}
    recognitions={recognitions}
  />
  <CertificationsSection
    tag={t('certifications.tag')}
    heading={t('certifications.heading')}
    body={t('certifications.body')}
    certifications={certifications}
  />
  <ClientLogosSection
    tag={t('clientLogos.tag')}
    heading={t('clientLogos.heading')}
    body={t('clientLogos.body')}
    logoAlt={t('clientLogos.logoAlt')}
    logo={resolveImage(t('clientLogos.logo'))}
  />
  <LetsBuildCTASection
    heading={t('ctaBanner.heading')}
    body={t('ctaBanner.body')}
    button={t('ctaBanner.button')}
    backgroundImage={resolveImage(t('ctaBanner.backgroundImage'))}
  />
  <ContactSection {...getContactSectionProps()} background="var(--color-surface-black)" />
  <NewsletterCTASection
    heading={t('newsletterCta.heading')}
    body={t('newsletterCta.body')}
    newsletterLabels={getNewsletterLabels()}
  />
</BaseLayout>
