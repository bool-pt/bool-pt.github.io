---
import { getCaseStudies, resolveImage } from '@bool/content';
import { t, tCollection, tOptional, isVisible } from '@bool/i18n';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import CaseStudyGridSection from '@bool/ui/sections/CaseStudyGridSection.astro';
import CertificationsSection from '@bool/ui/sections/CertificationsSection.astro';
import ClientLogosSection from '@bool/ui/sections/ClientLogosSection.astro';
import ContactSection from '@bool/ui/sections/ContactSection.astro';
import LetsBuildCTASection from '@bool/ui/sections/LetsBuildCTASection.astro';
import NewsletterCTASection from '@bool/ui/sections/NewsletterCTASection.astro';
import PortfolioHeroSection from '@bool/ui/sections/PortfolioHeroSection.astro';
import PortfolioStatsSection from '@bool/ui/sections/PortfolioStatsSection.astro';
import TestimonialsCarouselSection from '@bool/ui/sections/TestimonialsCarouselSection.astro';
import {
  getHeaderLabels,
  getFooterLabels,
  getContactSectionProps,
  getNewsletterLabels,
} from '../../labels';

const caseStudiesPayload = getCaseStudies();

const sectors = t('portfolioHero.sectors').split(',');

const clientTestimonials = tCollection('clientTestimonials', [
  'quote',
  'name',
  'role',
  'avatar',
]).map((item) => ({
  quote: item.quote,
  company: item.name,
  designation: item.role,
  avatar: resolveImage(item.avatar).src,
}));

const portfolioStats = tCollection('portfolioStats.items', ['value', 'label']);

const recognitionIcons = ['trophy', 'chart', 'shield', 'trophy'] as const;
const recognitions = tCollection('portfolioStats.recognition', ['title', 'description']).map(
  (r, i) => ({ ...r, iconName: recognitionIcons[i] ?? ('trophy' as const) })
);

const certifications = tCollection('certifications.items', ['name', 'count', 'label', 'logo']).map(
  (c) => ({
    name: c.name,
    count: c.count,
    label: c.label,
    logo: c.logo ? resolveImage(c.logo) : null,
  })
);

// Curated client logos. Empty entries are ignored; when none are set the
// section falls back to the full client-logos media folder, then a placeholder.
const clientLogos = tCollection('clientLogos.logos', ['image'])
  .map((l) => l.image)
  .filter(Boolean)
  .map((path) => resolveImage(path));

const bgClientTestimonials = tOptional('clientTestimonials.backgroundImage');
const bgPortfolioStats = tOptional('portfolioStats.backgroundImage');
const bgCertifications = tOptional('certifications.backgroundImage');
const bgClientLogos = tOptional('clientLogos.backgroundImage');
const bgNewsletterCta = tOptional('newsletterCta.backgroundImage');
const bgContactSection = tOptional('contactSection.backgroundImage');

const showPortfolioHero = isVisible('portfolioHero.visible');
const showCaseStudies = isVisible('caseStudies.visible');
const showClientTestimonials = isVisible('clientTestimonials.visible');
const showPortfolioStats = isVisible('portfolioStats.visible');
const showCertifications = isVisible('certifications.visible');
const showClientLogos = isVisible('clientLogos.visible');
const showCtaBanner = isVisible('ctaBanner.visible');
const showContactSection = isVisible('contactSection.visible');
const showNewsletterCta = isVisible('newsletterCta.visible');
---

<BaseLayout
  title={t('pageMeta.portfolio.title')}
  description={t('pageMeta.portfolio.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  {
    showPortfolioHero && (
      <div id="portfolioHero" class="section-anchor">
        <PortfolioHeroSection
          tag={t('portfolioHero.tag')}
          heading={t('portfolioHero.heading')}
          body={t('portfolioHero.body')}
          sectors={sectors}
          ctaStories={t('portfolioHero.cta.stories')}
          ctaStoriesHref={t('portfolioHero.cta.stories.href')}
          ctaServices={t('portfolioHero.cta.services')}
          ctaServicesHref={t('portfolioHero.cta.services.href')}
          stats={portfolioStats}
          backgroundImage={resolveImage(t('portfolioHero.backgroundImage'))}
        />
      </div>
    )
  }
  {
    showCaseStudies && (
      <div id="caseStudies" class="section-anchor">
        <CaseStudyGridSection payload={caseStudiesPayload} />
      </div>
    )
  }
  {
    showClientTestimonials && (
      <div id="clientTestimonials" class="section-anchor">
        <TestimonialsCarouselSection
          tag={t('clientTestimonials.tag')}
          heading={t('clientTestimonials.heading')}
          body={t('clientTestimonials.body')}
          testimonials={clientTestimonials}
          carouselAriaLabels={{ prev: t('carousel.previous'), next: t('carousel.next') }}
          backgroundImage={bgClientTestimonials ? resolveImage(bgClientTestimonials) : undefined}
        />
      </div>
    )
  }
  {
    showPortfolioStats && (
      <div id="portfolioStats" class="section-anchor">
        <PortfolioStatsSection
          tag={t('portfolioStats.tag')}
          heading={t('portfolioStats.heading')}
          body={t('portfolioStats.body')}
          stats={portfolioStats}
          recognitions={recognitions}
          backgroundImage={bgPortfolioStats ? resolveImage(bgPortfolioStats) : undefined}
        />
      </div>
    )
  }
  {
    showCertifications && (
      <div id="certifications" class="section-anchor">
        <CertificationsSection
          tag={t('certifications.tag')}
          heading={t('certifications.heading')}
          body={t('certifications.body')}
          certifications={certifications}
          backgroundImage={bgCertifications ? resolveImage(bgCertifications) : undefined}
        />
      </div>
    )
  }
  {
    showClientLogos && (
      <div id="clientLogos" class="section-anchor">
        <ClientLogosSection
          tag={t('clientLogos.tag')}
          heading={t('clientLogos.heading')}
          body={t('clientLogos.body')}
          logos={clientLogos}
          backgroundImage={bgClientLogos ? resolveImage(bgClientLogos) : undefined}
        />
      </div>
    )
  }
  {
    showCtaBanner && (
      <div id="ctaBanner" class="section-anchor">
        <LetsBuildCTASection
          heading={t('ctaBanner.heading')}
          body={t('ctaBanner.body')}
          button={t('common.talkToExpert')}
          buttonHref={t('ctaBanner.cta.href')}
          backgroundImage={resolveImage(t('ctaBanner.backgroundImage'))}
        />
      </div>
    )
  }
  {
    showContactSection && (
      <div id="contactSection" class="section-anchor">
        <ContactSection
          {...getContactSectionProps()}
          background="var(--color-surface-black)"
          backgroundImage={bgContactSection ? resolveImage(bgContactSection) : undefined}
        />
      </div>
    )
  }
  {
    showNewsletterCta && (
      <div id="newsletterCta" class="section-anchor">
        <NewsletterCTASection
          heading={t('newsletterCta.heading')}
          body={t('newsletterCta.body')}
          newsletterLabels={getNewsletterLabels()}
          backgroundImage={bgNewsletterCta ? resolveImage(bgNewsletterCta) : undefined}
        />
      </div>
    )
  }
</BaseLayout>
