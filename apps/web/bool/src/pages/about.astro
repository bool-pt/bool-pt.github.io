---
import { getTeamGrid, resolveImage } from '@bool/content';
import { t, tOptional, tCollection, isVisible } from '@bool/i18n';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import AboutHeroSection from '@bool/ui/sections/AboutHeroSection.astro';
import BoolInNumbersSection from '@bool/ui/sections/BoolInNumbersSection.astro';
import ContactSection from '@bool/ui/sections/ContactSection.astro';
import FeaturedTechSection from '@bool/ui/sections/FeaturedTechSection.astro';
import FromPortugalSection from '@bool/ui/sections/FromPortugalSection.astro';
import PowerAISection from '@bool/ui/sections/PowerAISection.astro';
import TeamGridSection from '@bool/ui/sections/TeamGridSection.astro';
import { getHeaderLabels, getFooterLabels, getContactSectionProps } from '../labels';

const teamGridPayload = getTeamGrid();
const teamGridBg = tOptional('teamGrid.backgroundImage');
const bgBoolInNumbers = tOptional('statsOverview.backgroundImage');
const bgPowerAi = tOptional('powerAi.backgroundImage');
const bgFeaturedTech = tOptional('featuredTech.backgroundImage');
const bgFromPortugal = tOptional('officeLocations.backgroundImage');
const bgContactSection = tOptional('contactSection.backgroundImage');

const showAboutHero = isVisible('aboutHero.visible');
const showStatsOverview = isVisible('statsOverview.visible');
const showPowerAi = isVisible('powerAi.visible');
const showFeaturedTech = isVisible('featuredTech.visible');
const showTeamGrid = isVisible('teamGrid.visible');
const showOfficeLocations = isVisible('officeLocations.visible');
const showContactSection = isVisible('contactSection.visible');

const stats = tCollection('statsOverview.items', ['value', 'label']).map((s) => ({
  number: s.value,
  label: s.label,
}));

const offices = tCollection('officeLocations.office', ['city', 'building', 'address', 'image']).map(
  (o) => ({
    city: o.city,
    building: o.building,
    address: o.address,
    image: resolveImage(o.image).src,
  })
);

const technologies = tCollection('featuredTech.items', ['name', 'color', 'href', 'logo']).map(
  (tech) => ({
    name: tech.name,
    color: tech.color,
    href: tech.href,
    logo: resolveImage(tech.logo),
  })
);
---

<BaseLayout
  title={t('pageMeta.about.title')}
  description={t('pageMeta.about.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  {
    showAboutHero && (
      <div id="aboutHero" class="section-anchor">
        <AboutHeroSection
          heading={t('aboutHero.heading')}
          body1={t('aboutHero.body1')}
          body2={t('aboutHero.body2')}
          missionTitle={t('aboutHero.mission.title')}
          missionBody={t('aboutHero.mission.body')}
          visionTitle={t('aboutHero.vision.title')}
          visionBody={t('aboutHero.vision.body')}
          backgroundImage={resolveImage(t('aboutHero.backgroundImage'))}
        />
      </div>
    )
  }
  {
    showStatsOverview && (
      <div id="statsOverview" class="section-anchor">
        <BoolInNumbersSection
          heading={t('statsOverview.heading')}
          body={t('statsOverview.body')}
          imageAlt={t('statsOverview.image.alt')}
          stats={stats}
          image={resolveImage(t('statsOverview.image'))}
          backgroundImage={bgBoolInNumbers ? resolveImage(bgBoolInNumbers) : undefined}
        />
      </div>
    )
  }
  {
    showPowerAi && (
      <div id="powerAi" class="section-anchor">
        <PowerAISection
          variant="image-left"
          heading={t('powerAi.heading')}
          body1={t('powerAi.body1')}
          body2={t('powerAi.body2')}
          cta={t('powerAi.cta')}
          ctaHref={t('powerAi.cta.href')}
          imageAlt={t('powerAi.image.alt')}
          image={resolveImage(t('powerAi.image'))}
          backgroundImage={bgPowerAi ? resolveImage(bgPowerAi) : undefined}
        />
      </div>
    )
  }
  {
    showFeaturedTech && (
      <div id="featuredTech" class="section-anchor">
        <FeaturedTechSection
          heading={t('featuredTech.heading')}
          body={t('featuredTech.body')}
          logoSuffix={t('featuredTech.logoSuffix')}
          technologies={technologies}
          learnMoreLabel={t('common.learnMore')}
          backgroundImage={bgFeaturedTech ? resolveImage(bgFeaturedTech) : undefined}
        />
      </div>
    )
  }
  {
    showTeamGrid && (
      <div id="teamGrid" class="section-anchor">
        <TeamGridSection
          payload={teamGridPayload}
          backgroundImage={teamGridBg ? resolveImage(teamGridBg) : undefined}
        />
      </div>
    )
  }
  {
    showOfficeLocations && (
      <div id="officeLocations" class="section-anchor">
        <FromPortugalSection
          heading={t('officeLocations.heading')}
          description={t('officeLocations.body')}
          offices={offices}
          carouselAriaLabels={{
            prev: t('carousel.previous'),
            next: t('carousel.next'),
            imageAlt: t('officeLocations.imageAlt'),
          }}
          backgroundImage={bgFromPortugal ? resolveImage(bgFromPortugal) : undefined}
        />
      </div>
    )
  }
  {
    showContactSection && (
      <div id="contactSection" class="section-anchor">
        <ContactSection
          {...getContactSectionProps()}
          background="var(--color-surface-black)"
          backgroundImage={bgContactSection ? resolveImage(bgContactSection) : undefined}
        />
      </div>
    )
  }
</BaseLayout>
