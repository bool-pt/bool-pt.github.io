---
import { getTeam, transformTeamMember } from '@bool/content';
import { t, tCollection } from '@bool/i18n';
import BaseLayout from '@bool/ui/layout/BaseLayout.astro';
import AboutHeroSection from '@bool/ui/sections/AboutHeroSection.astro';
import BoolInNumbersSection from '@bool/ui/sections/BoolInNumbersSection.astro';
import ContactSection from '@bool/ui/sections/ContactSection.astro';
import FeaturedTechSection from '@bool/ui/sections/FeaturedTechSection.astro';
import FromPortugalSection from '@bool/ui/sections/FromPortugalSection.astro';
import PowerAISection from '@bool/ui/sections/PowerAISection.astro';
import TeamGridSection from '@bool/ui/sections/TeamGridSection.astro';
import { getHeaderLabels, getFooterLabels, getContactSectionProps } from '../labels';

const teamMembers = await getTeam();
const teamItems = teamMembers.map(transformTeamMember);

const stats = tCollection('statsOverview.items', ['value', 'label'])
  .map((s) => ({ number: s.value, label: s.label }));

const offices = tCollection('officeLocations.office', ['city', 'building', 'address']);

const technologies = tCollection('featuredTech.items', ['name', 'color', 'href', 'logoKey']);
---

<BaseLayout
  title={t('pageMeta.about.title')}
  description={t('pageMeta.about.description')}
  headerLabels={getHeaderLabels()}
  footerLabels={getFooterLabels()}
>
  <AboutHeroSection
    heading={t('aboutHero.heading')}
    body1={t('aboutHero.body1')}
    body2={t('aboutHero.body2')}
    missionTitle={t('aboutHero.mission.title')}
    missionBody={t('aboutHero.mission.body')}
    visionTitle={t('aboutHero.vision.title')}
    visionBody={t('aboutHero.vision.body')}
  />
  <BoolInNumbersSection
    heading={t('statsOverview.heading')}
    body={t('statsOverview.body')}
    imageAlt={t('statsOverview.image.alt')}
    stats={stats}
  />
  <PowerAISection
    variant="image-left"
    heading={t('powerAi.heading')}
    body1={t('powerAi.body1')}
    body2={t('powerAi.body2')}
    cta={t('powerAi.cta')}
    imageAlt={t('powerAi.image.alt')}
  />
  <FeaturedTechSection
    heading={t('featuredTech.heading')}
    body={t('featuredTech.body')}
    logoSuffix={t('featuredTech.logoSuffix')}
    technologies={technologies}
    learnMoreLabel={t('common.learnMore')}
  />
  <TeamGridSection
    heading={t('teamGrid.heading')}
    body={t('teamGrid.body')}
    team={teamItems}
  />
  <FromPortugalSection
    heading={t('officeLocations.heading')}
    description={t('officeLocations.body')}
    offices={offices}
    carouselAriaLabels={{
      prev: t('officeLocations.carousel.prev'),
      next: t('officeLocations.carousel.next'),
      imageAlt: t('officeLocations.imageAlt'),
    }}
  />
  <ContactSection {...getContactSectionProps()} background="var(--color-surface-black)" />
</BaseLayout>
