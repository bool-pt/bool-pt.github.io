# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Figma MCP — personal access token (Figma > Settings > Account > Personal access tokens)
FIGMA_API_KEY=

# Contact form Lambda endpoint
PUBLIC_CONTACT_API_URL=http://localhost:3001/contact

# Newsletter Lambda endpoint
PUBLIC_NEWSLETTER_API_URL=http://localhost:3001/newsletter

# hCaptcha site key (public — safe to commit once obtained)
PUBLIC_HCAPTCHA_SITE_KEY=

# Google Analytics 4 measurement ID (public — safe to commit once obtained)
PUBLIC_GA_MEASUREMENT_ID=

# Sentry DSN for error monitoring (public — safe to commit, identifies project only)
PUBLIC_SENTRY_DSN=
